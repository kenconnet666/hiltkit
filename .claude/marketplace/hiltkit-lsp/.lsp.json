{
  "typescript": {
    "command": "node",
    "args": ["${CLAUDE_PROJECT_DIR}/node_modules/typescript/bin/tsc", "--lsp", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript"
    },
    "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
    "startupTimeout": 30000
  }
}
