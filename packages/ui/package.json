{
  "name": "@hiltkit/ui",
  "version": "0.0.0",
  "description": "hiltkit 的组件库",
  "type": "module",
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/hiltkit.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "./test/**",
    "./src/index.ts",
    "./src/theme/tokens.ts",
    "./dist/index.js",
    "./dist/theme/tokens.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@hiltkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/zh-CN": {
      "@hiltkit/source": "./src/locale/zh-CN.ts",
      "types": "./dist/locale/zh-CN.d.ts",
      "default": "./dist/locale/zh-CN.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test:integration": "node test/integration/run.mjs"
  },
  "peerDependencies": {
    "hiltkit": "workspace:^"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "hiltkit": "workspace:^",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
