{
  "name": "hiltkit",
  "version": "0.0.0",
  "description": "细粒度响应的 Web 框架：标准 TS JSX，不需要编译插件",
  "type": "module",
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/hiltkit.git",
    "directory": "packages/core"
  },
  "sideEffects": [
    "./src/css/index.ts",
    "./src/css/register.ts",
    "./src/devtools/index.ts",
    "./dist/css/index.js",
    "./dist/css/register.js",
    "./dist/devtools/index.js",
    "./test/**"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "@hiltkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": {
      "@hiltkit/source": "./src/css/index.ts",
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.js"
    },
    "./devtools": {
      "@hiltkit/source": "./src/devtools/index.ts",
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./vite": {
      "@hiltkit/source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./jsx-runtime": {
      "@hiltkit/source": "./src/jsx-runtime.ts",
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "@hiltkit/source": "./src/jsx-dev-runtime.ts",
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test:integration": "node test/integration/all.mjs",
    "check:generated": "node scripts/gen-property-groups.mjs --check && node scripts/check-events.mjs"
  },
  "dependencies": {
    "alien-signals": "catalog:",
    "csstype": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "bin": {
    "hiltkit-devtools": "./bin/cli.mjs",
    "hiltkit-devtools-mcp": "./bin/mcp.mjs"
  }
}
