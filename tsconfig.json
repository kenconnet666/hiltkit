{
  // 全仓库的页面代码一次检查。各包之间解析到源码，不用先构建。
  // src/vite 跑在 Node 里，归 tsconfig.node.json；integration/lib 专门测构建产物，由它自己的脚本检查
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@hiltkit/source"]
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src"],
  "exclude": ["packages/core/src/vite", "packages/core/test/integration/lib", "**/dist"]
}
